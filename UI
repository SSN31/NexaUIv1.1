                TS:Create(kb,TweenInfo.new(0.2,Enum.EasingStyle.Quad),{Position=state and UDim2.new(0,KNOB_ON,0.5,-5) or UDim2.new(0,KNOB_OFF,0.5,-5),BackgroundColor3=state and Color3.new(1,1,1) or Color3.fromRGB(200,200,200)}):Play()
