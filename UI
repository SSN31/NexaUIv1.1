    -- ============================================================
    function W:_UpdateHUD()
        for _,c in pairs(W.HUDList:GetChildren()) do if c:IsA("TextLabel") then c:Destroy() end end
        local count = 0
        for name,mod in pairs(W.Modules) do
            if mod.Get and mod:Get() then
                count = count + 1
                local l = Instance.new("TextLabel"); l.Size = UDim2.new(1,0,0,14)
                l.BackgroundTransparency = 1; l.Text = "+ "..name; l.TextColor3 = Color3.fromRGB(100,255,160)
                l.Font = W.CurrentFont; l.TextSize = 10; l.TextXAlignment = Enum.TextXAlignment.Left
                l.ZIndex = 102; l.Parent = W.HUDList
            end
        end
        if count == 0 then
            local l = Instance.new("TextLabel"); l.Size = UDim2.new(1,0,0,14)
            l.BackgroundTransparency = 1; l.Text = "No active modules"
            l.TextColor3 = Color3.fromRGB(100,100,120); l.Font = W.CurrentFont; l.TextSize = 10
            l.TextXAlignment = Enum.TextXAlignment.Left; l.ZIndex = 102; l.Parent = W.HUDList
        end
    end
    
    -- ============================================================
    -- COLUMN CREATION
    -- ============================================================
    local function reflowColumns(width)
        W._currentColW = width
        for idx,col in ipairs(W.AllColumns) do
            if col and col.Frame then
                local saved = W.SavedPositions[col.Frame.Name]
                local posX = START_X + (idx-1) * (width + COL_GAP)
                local posY = START_Y
                if saved then posY = saved.Y.Offset end
                col.Frame.Position = UDim2.new(0, posX, 0, posY)
                col.Frame.Size = UDim2.new(0, width, 0, col.Frame.Size.Y.Offset)
            end
        end
    end
    
