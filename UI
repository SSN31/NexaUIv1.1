        icon.Font = W.CurrentFont; icon.TextSize = 13; icon.ZIndex = 12; icon.Parent = header
        table.insert(W.ColumnIcons, icon); table.insert(W.FontedElements, icon)
        
        local title = Instance.new("TextLabel"); title.Size = UDim2.new(1,-34,1,0); title.Position = UDim2.new(0,28,0,0)
