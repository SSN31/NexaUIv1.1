            if sliding and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
                local w = math.max(track.AbsoluteSize.X,1); local d = input.Position.X-dsx
                apply(math.floor(min + math.clamp(dsp+(d/w),0,1)*(max-min)+0.5))
            end
        end)
        local bConn2 = UIS.InputEnded:Connect(function(input)
            if sliding and (input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch) then sliding=false end
        end)
        table.insert(W._connections, bConn1)
        table.insert(W._connections, bConn2)
        local so = {Frame=row, Get=function() return val end, Set=function(_,v,silent) apply(v, silent) end}
        W.Modules[name] = so; return so
    end
    
    makeBuiltinSlider("FOV", 70, 120, 70, function(v) workspace.CurrentCamera.FieldOfView = v end)
    makeBuiltinSlider("UI Transparency", 0, 70, 0, function(v) W.UITransparencyVal = v; W:ApplyUITransparency(v/100) end)
    makeBuiltinSlider("UI Scale", 70, 150, 100, function(v)
        W.UIScaleVal = v/100
        for _,s in ipairs(W.ColumnScales) do if s and s.Parent then s.Scale = W.UIScaleVal end end
        W.HUDScale.Scale = W.UIScaleVal
    end)
    
    -- Divider
    local d3 = Instance.new("Frame"); d3.Size = UDim2.new(1,-20,0,1); d3.Position = UDim2.new(0,10,0,0)
    d3.BackgroundColor3 = Color3.fromRGB(35,35,42); d3.BorderSizePixel = 0; d3.ZIndex = 11; d3.Parent = themeCol.List
    
    -- LAYOUT header
    local sl3 = Instance.new("TextLabel"); sl3.Size = UDim2.new(1,-20,0,16); sl3.Position = UDim2.new(0,10,0,0)
    sl3.BackgroundTransparency = 1; sl3.Text = "LAYOUT"; sl3.TextColor3 = W.CurrentAccent
    sl3.Font = W.CurrentFont; sl3.TextSize = 9; sl3.TextXAlignment = Enum.TextXAlignment.Left
    sl3.ZIndex = 11; sl3.Parent = themeCol.List
    table.insert(W.FontedElements, sl3); table.insert(W.TitleLabels, sl3)
    
    makeBuiltinSlider("Column Width", 120, 240, 152, function(v) reflowColumns(v) end)
    
    -- ============================================================
    -- CINEMATIC INTRO & INITIAL STATE
    -- ============================================================
    W.UIOpen = false
    W.HUDFrame.Position = UDim2.new(0, -210, 0, 70)
    W.HUDFrame.Visible = false
    for _, col in pairs(W.AllColumns) do
        col.Frame.Visible = false
        col.Frame.Position = UDim2.new(col.Frame.Position.X.Scale, col.Frame.Position.X.Offset - (W._currentColW + 40), col.Frame.Position.Y.Scale, col.Frame.Position.Y.Offset)
    end

    W.Backdrop.Visible = true
    TS:Create(W.Backdrop, TweenInfo.new(0.5), {BackgroundTransparency = 0.55}):Play()

    local introContainer = Instance.new("Frame")
    introContainer.Size = UDim2.new(0, 240, 0, 80)
    introContainer.Position = UDim2.new(0.5, 0, 0.5, 20)
    introContainer.AnchorPoint = Vector2.new(0.5, 0.5)
    introContainer.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
    introContainer.BackgroundTransparency = 1
    introContainer.BorderSizePixel = 0
    introContainer.ZIndex = 1000
    introContainer.Parent = W.ScreenGui
    Cr(introContainer, 6)
    
    local introStroke = Instance.new("UIStroke", introContainer)
    introStroke.Color = W.CurrentAccent
    introStroke.Transparency = 1

    local introTitle = Instance.new("TextLabel", introContainer)
    introTitle.Size = UDim2.new(0, 100, 0, 30)
    introTitle.Position = UDim2.new(0, 20, 1, -40)
    introTitle.BackgroundTransparency = 1
    introTitle.Text = config.Name or "NexaUI"
    introTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    introTitle.Font = W.CurrentFont
    introTitle.TextSize = 18
    introTitle.TextXAlignment = Enum.TextXAlignment.Left
    introTitle.TextTransparency = 1
    introTitle.ZIndex = 1001

    local introMsg = Instance.new("TextLabel", introContainer)
    introMsg.Size = UDim2.new(1, -40, 0, 20)
    introMsg.Position = UDim2.new(0, 20, 0, 15)
    introMsg.BackgroundTransparency = 1
    introMsg.Text = "Initializing Environment..."
    introMsg.TextColor3 = Color3.fromRGB(160, 160, 170)
    introMsg.Font = W.CurrentFont
    introMsg.TextSize = 12
    introMsg.TextXAlignment = Enum.TextXAlignment.Left
    introMsg.TextTransparency = 1
    introMsg.ZIndex = 1001

    local introStar = Instance.new("TextLabel", introContainer)
    introStar.Size = UDim2.new(0, 30, 0, 30)
    introStar.Position = UDim2.new(1, -50, 1, -40)
    introStar.BackgroundTransparency = 1
    introStar.Text = "❖"
    introStar.TextColor3 = W.CurrentAccent
    introStar.Font = Enum.Font.Gotham
    introStar.TextSize = 24
    introStar.TextTransparency = 1
    introStar.ZIndex = 1002

    task.spawn(function()
        TS:Create(introContainer, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundTransparency = 0}):Play()
        TS:Create(introStroke, TweenInfo.new(0.5), {Transparency = 0}):Play()
        task.wait(0.3)
        TS:Create(introTitle, TweenInfo.new(0.5), {TextTransparency = 0}):Play()
        TS:Create(introMsg, TweenInfo.new(0.5), {TextTransparency = 0}):Play()
        TS:Create(introStar, TweenInfo.new(0.5), {TextTransparency = 0}):Play()
        
        task.wait(2.6)

        TS:Create(introTitle, TweenInfo.new(0.4), {TextTransparency = 1, Position = UDim2.new(0, 0, 1, -40)}):Play()
        TS:Create(introMsg, TweenInfo.new(0.4), {TextTransparency = 1, Position = UDim2.new(0, 0, 0, 15)}):Play()
        TS:Create(introContainer, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut), {Size = UDim2.new(0, 80, 0, 80), BackgroundTransparency = 1}):Play()
        TS:Create(introStroke, TweenInfo.new(0.5), {Transparency = 1}):Play()
        
        TS:Create(introStar, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut), {Position = UDim2.new(0.5, -15, 0.5, -15), TextSize = 36}):Play()
        task.wait(0.5)
        
        local spinTween = TS:Create(introStar, TweenInfo.new(1.2, Enum.EasingStyle.Back, Enum.EasingDirection.InOut), {Rotation = 720})
        spinTween:Play()
        spinTween.Completed:Wait()

        local orbCount = 8
        for i = 1, orbCount do
            local angle = (math.pi * 2 / orbCount) * i
            local orb = Instance.new("Frame", introContainer)
            orb.Size = UDim2.new(0, 6, 0, 6)
            orb.AnchorPoint = Vector2.new(0.5, 0.5)
            orb.Position = UDim2.new(0.5, 0, 0.5, 0)
            orb.BackgroundColor3 = W.CurrentAccent
            orb.BorderSizePixel = 0
            orb.ZIndex = 999
            Cr(orb, 100)
            
            local targetX = math.cos(angle) * 80
            local targetY = math.sin(angle) * 80
            
            TS:Create(orb, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, targetX, 0.5, targetY), BackgroundTransparency = 1, Size = UDim2.new(0, 2, 0, 2)}):Play()
            task.delay(0.5, function() orb:Destroy() end)
        end

        TS:Create(introStar, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextSize = 0, TextTransparency = 1, Rotation = 1080}):Play()
        task.wait(0.3)
        
        introContainer:Destroy()
        
        W:ToggleUI()
        
        if W.BreathingEnabled then W:StartBreathing() end
        W:_UpdateHUD()
        W:Notify({Title = config.Name or "NexaUI", Content = "Loaded. Press " .. W.KeybindToggle.Name .. " to toggle.", Type = "success", Duration = 5})
    end)
    
    NexaUI._lastWindow = W
    return W
end

function NexaUI:Destroy()
    if self._lastWindow then self._lastWindow:Destroy() end
end

function NexaUI:Notify(opts)
    if self._lastWindow then self._lastWindow:Notify(opts) end
end

function NexaUI:SaveConfig(name)
    if self._lastWindow then self._lastWindow:SaveConfig(name) end
end

function NexaUI:LoadConfig(name)
    if self._lastWindow then self._lastWindow:LoadConfig(name) end
end

function NexaUI:SetConfigName(name)
    if self._lastWindow then self._lastWindow:SetConfigName(name) end
end

function NexaUI:Toggle()
    if self._lastWindow then self._lastWindow:ToggleUI() end
end

return NexaUI
