    W.HUDFrame.Name = "HUD"; W.HUDFrame.Size = UDim2.new(0,200,0,0)
    W.HUDFrame.AutomaticSize = Enum.AutomaticSize.Y
    W.HUDFrame.Position = UDim2.new(0,10,0,70)
    W.HUDFrame.BackgroundColor3 = Color3.fromRGB(12,12,18)
    W.HUDFrame.BackgroundTransparency = 0.2
    W.HUDFrame.BorderSizePixel = 0; W.HUDFrame.ZIndex = 100; W.HUDFrame.Parent = W.ScreenGui
    Cr(W.HUDFrame, 6)
    W.HUDScale = Instance.new("UIScale"); W.HUDScale.Scale = W.UIScaleVal; W.HUDScale.Parent = W.HUDFrame
    local hb = Instance.new("UIStroke"); hb.Color = Color3.fromRGB(60,40,80); hb.Thickness = 1; hb.Parent = W.HUDFrame
    table.insert(W.UIStrokes, hb)
    local hp = Instance.new("UIPadding"); hp.PaddingTop = UDim.new(0,6); hp.PaddingLeft = UDim.new(0,8)
    hp.PaddingRight = UDim.new(0,8); hp.PaddingBottom = UDim.new(0,6); hp.Parent = W.HUDFrame
    Instance.new("UIListLayout", W.HUDFrame).Padding = UDim.new(0,2)
    
    W.HUDTitle = Instance.new("TextLabel")
    W.HUDTitle.Size = UDim2.new(1,0,0,16); W.HUDTitle.BackgroundTransparency = 1
    W.HUDTitle.Text = config.Name or "NexaUI"
    W.HUDTitle.TextColor3 = W.CurrentAccent; W.HUDTitle.Font = W.CurrentFont
    W.HUDTitle.TextSize = 11; W.HUDTitle.TextXAlignment = Enum.TextXAlignment.Left
    W.HUDTitle.ZIndex = 101; W.HUDTitle.Parent = W.HUDFrame
    table.insert(W.TitleLabels, W.HUDTitle); table.insert(W.FontedElements, W.HUDTitle)
    
    local hudSep = Instance.new("Frame"); hudSep.Size = UDim2.new(1,0,0,1)
    hudSep.BackgroundColor3 = Color3.fromRGB(50,30,70); hudSep.BorderSizePixel = 0; hudSep.ZIndex = 101; hudSep.Parent = W.HUDFrame
    
    W.HUDList = Instance.new("Frame"); W.HUDList.Name = "HUDList"
    W.HUDList.Size = UDim2.new(1,0,0,0); W.HUDList.AutomaticSize = Enum.AutomaticSize.Y
    W.HUDList.BackgroundTransparency = 1; W.HUDList.ZIndex = 101; W.HUDList.Parent = W.HUDFrame
    Instance.new("UIListLayout", W.HUDList).Padding = UDim.new(0,1)
    
    local hint = Instance.new("TextLabel"); hint.Size = UDim2.new(1,0,0,12)
    hint.BackgroundTransparency = 1; hint.Text = "["..W.KeybindToggle.Name.."] Toggle UI"
    hint.TextColor3 = Color3.fromRGB(80,80,100); hint.Font = W.CurrentFont
    hint.TextSize = 9; hint.TextXAlignment = Enum.TextXAlignment.Left
    hint.ZIndex = 101; hint.Parent = W.HUDFrame
    table.insert(W.FontedElements, hint)
    
    W.NotifColors = {
        info    = {bar = W.CurrentAccent, bg = Color3.fromRGB(18,22,36)},
        success = {bar = Color3.fromRGB(80,220,130), bg = Color3.fromRGB(18,28,22)},
        warning = {bar = Color3.fromRGB(220,180,60), bg = Color3.fromRGB(30,26,16)},
        alert   = {bar = Color3.fromRGB(220,70,70), bg = Color3.fromRGB(30,16,16)},
    }
    
    -- ============================================================
    -- THEME FUNCTIONS
    -- ============================================================
    function W:ApplyAccentColor()
        for _, tbl in pairs({W.UIStrokes, W.TitleLabels, W.ColumnIcons, W.SliderFills, W.SliderHandles}) do
            for i = #tbl,1,-1 do if not tbl[i] or not tbl[i].Parent then table.remove(tbl,i) end end
        end
        pcall(function()
            for _,s in ipairs(W.UIStrokes) do
                if s and s.Parent then TS:Create(s,TweenInfo.new(0.2),{Color=W.CurrentAccent}):Play() end
            end
            if W.HUDTitle and W.HUDTitle.Parent then TS:Create(W.HUDTitle,TweenInfo.new(0.2),{TextColor3=W.CurrentAccent}):Play() end
            for _,i in ipairs(W.ColumnIcons) do
                if i and i.Parent then TS:Create(i,TweenInfo.new(0.2),{TextColor3=W.CurrentAccent}):Play() end
            end
            for _,l in ipairs(W.TitleLabels) do
                if l and l.Parent then TS:Create(l,TweenInfo.new(0.2),{TextColor3=W.CurrentAccent}):Play() end
            end
            for _,t in ipairs(W.ParagraphTitles) do
                if t and t.Parent then TS:Create(t,TweenInfo.new(0.2),{TextColor3=W.CurrentAccent}):Play() end
            end
            for _,f in ipairs(W.SliderFills) do
                if f and f.Parent then TS:Create(f,TweenInfo.new(0.2),{BackgroundColor3=W.CurrentAccent}):Play() end
            end
            for _,h in ipairs(W.SliderHandles) do
                if h and h.Parent then TS:Create(h,TweenInfo.new(0.2),{BackgroundColor3=W.CurrentAccent}):Play() end
            end
            W.NotifColors.info.bar = W.CurrentAccent
            for i=#W.AllModuleUI,1,-1 do
                local item = W.AllModuleUI[i]
                if not item or not item.Row.Parent then table.remove(W.AllModuleUI,i) else item.Update() end
            end
        end)
    end
    
    function W:ApplyFont()
        for i=#W.FontedElements,1,-1 do
            if not W.FontedElements[i] or not W.FontedElements[i].Parent then table.remove(W.FontedElements,i) end
        end
        pcall(function()
            for _,el in ipairs(W.FontedElements) do
                if el and el.Parent then el.Font = W.CurrentFont end
            end
        end)
    end
    
    function W:ApplyUITransparency(t)
        pcall(function()
            for _,f in ipairs(W.ColFrames) do if f and f.Parent then f.BackgroundTransparency = t end end
            for _,h in ipairs(W.ColHeaders) do if h and h.Parent then h.BackgroundTransparency = t end end
            for _,hf in ipairs(W.ColHeaderFills) do if hf and hf.Parent then hf.BackgroundTransparency = t end end
            for _,r in ipairs(W.ModuleRows) do if r and r.Parent then r.BackgroundTransparency = t end end
            for _,r in ipairs(W.SliderRows) do if r and r.Parent then r.BackgroundTransparency = t end end
            for _,f in ipairs(W.InputFrames) do if f and f.Parent then f.BackgroundTransparency = t end end
            for _,f in ipairs(W.ParagraphFrames) do if f and f.Parent then f.BackgroundTransparency = t end end
            if W.HUDFrame and W.HUDFrame.Parent then W.HUDFrame.BackgroundTransparency = t end
        end)
    end
    
    function W:StartBreathing()
        if W.BreathingState.Active then return end
        W.BreathingState.Active = true
        W.BreathingState.Connection = task.spawn(function()
            while W.BreathingState.Active do
                for _,s in ipairs(W.UIStrokes) do
                    if s and s.Parent then TS:Create(s,TweenInfo.new(1.5,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{Color=Darken(W.CurrentAccent,0.4)}):Play() end
                end
                task.wait(1.5)
                if not W.BreathingState.Active then break end
                for _,s in ipairs(W.UIStrokes) do
                    if s and s.Parent then TS:Create(s,TweenInfo.new(1.5,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{Color=Lighten(W.CurrentAccent,0.3)}):Play() end
                end
                task.wait(1.5)
            end
        end)
    end
    
    function W:StopBreathing()
        W.BreathingState.Active = false
        W.BreathingState.Connection = nil
        W:ApplyAccentColor()
    end
    
    -- ============================================================
    -- TOGGLE UI
    -- ============================================================
    function W:ToggleUI()
        if W.ToggleAnimating then return end
        W.ToggleAnimating = true
        W.UIOpen = not W.UIOpen
        
        local function initTransparencies(parent)
            if parent:GetAttribute("OrigBg") == nil then parent:SetAttribute("OrigBg", parent.BackgroundTransparency) end
            for _, d in ipairs(parent:GetDescendants()) do
                if d:IsA("Frame") or d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    if d:GetAttribute("OrigBg") == nil then d:SetAttribute("OrigBg", d.BackgroundTransparency) end
                end
                if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    if d:GetAttribute("OrigTxt") == nil then d:SetAttribute("OrigTxt", d.TextTransparency) end
                end
                if d:IsA("UIStroke") then
                    if d:GetAttribute("OrigStr") == nil then d:SetAttribute("OrigStr", d.Transparency) end
                end
            end
        end

        for _,col in pairs(W.AllColumns) do initTransparencies(col.Frame) end
        initTransparencies(W.HUDFrame)
        
        local ft = W.UITransparencyVal / 100

        if W.UIOpen then
            W.ScreenGui.Enabled = true
            W.Backdrop.Visible = true
            TS:Create(W.Backdrop, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundTransparency=0.55}):Play()
            
            W.HUDFrame.Visible = true
            TS:Create(W.HUDFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position=UDim2.new(0,10,0,70)}):Play()
            
            for _,col in pairs(W.AllColumns) do
                col.Frame.Visible = true
                local saved = W.SavedPositions[col.Frame.Name]
                if saved then 
                    col.Frame.Position = UDim2.new(saved.X.Scale, saved.X.Offset - (W._currentColW+40), saved.Y.Scale, saved.Y.Offset)
                    TS:Create(col.Frame, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position=saved}):Play()
                end
            end

            local function fadeIn(parent)
                local obg = parent:GetAttribute("OrigBg")
                if obg then TS:Create(parent, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundTransparency = math.max(obg, ft)}):Play() end
                
                for _, d in ipairs(parent:GetDescendants()) do
                    if d:IsA("Frame") or d:IsA("TextButton") or d:IsA("TextLabel") or d:IsA("TextBox") then
                        local origBg = d:GetAttribute("OrigBg")
                        if origBg then
                            local targetBg = (origBg < 1) and math.max(origBg, ft) or 1
                            TS:Create(d, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundTransparency=targetBg}):Play()
                        end
                    end
                    if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                        local origTxt = d:GetAttribute("OrigTxt")
                        if origTxt then TS:Create(d, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {TextTransparency=origTxt}):Play() end
                    end
                    if d:IsA("UIStroke") then
                        local origStr = d:GetAttribute("OrigStr")
                        if origStr then TS:Create(d, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Transparency=origStr}):Play() end
                    end
                end
            end

            for _,col in pairs(W.AllColumns) do fadeIn(col.Frame) end
            fadeIn(W.HUDFrame)
            
            task.delay(0.45, function() W.ToggleAnimating = false end)
        else
            TS:Create(W.Backdrop, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {BackgroundTransparency=1}):Play()
            TS:Create(W.HUDFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Position=UDim2.new(0,-210,0,70)}):Play()
            
            for _,col in pairs(W.AllColumns) do
                local pos = col.Frame.Position
                W.SavedPositions[col.Frame.Name] = pos
                TS:Create(col.Frame, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Position=UDim2.new(pos.X.Scale, pos.X.Offset-(W._currentColW+40), pos.Y.Scale, pos.Y.Offset)}):Play()
            end

            local function fadeOut(parent)
                TS:Create(parent, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {BackgroundTransparency=1}):Play()
                for _, d in ipairs(parent:GetDescendants()) do
                    if d:IsA("Frame") or d:IsA("TextButton") or d:IsA("TextLabel") or d:IsA("TextBox") then
                        TS:Create(d, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {BackgroundTransparency=1}):Play()
                    end
                    if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                        TS:Create(d, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {TextTransparency=1}):Play()
                    end
                    if d:IsA("UIStroke") then
                        TS:Create(d, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Transparency=1}):Play()
                    end
                end
            end

            for _,col in pairs(W.AllColumns) do fadeOut(col.Frame) end
            fadeOut(W.HUDFrame)
            
            task.delay(0.45, function()
                if not W.UIOpen then
                    W.ScreenGui.Enabled = false
                    W.HUDFrame.Visible = false
                    for _,col in pairs(W.AllColumns) do col.Frame.Visible = false end
                    W.ToggleAnimating = false
                end
            end)
        end
    end
    
    -- ============================================================
    -- NOTIFY
    -- ============================================================
    function W:Notify(opts)
        if typeof(opts) == "string" then opts = {Title="NexaUI", Content=opts, Duration=4} end
        opts.Title = opts.Title or "NexaUI"; opts.Content = opts.Content or ""
        opts.Duration = opts.Duration or 4; opts.Type = opts.Type or "info"
        pcall(function()
            local colors = W.NotifColors[opts.Type] or W.NotifColors.info
            local nc = 0; for _ in pairs(W.ActiveNotifs) do nc = nc + 1 end
            local sP, eP, xP
            if W.CurrentNotifPos == "Top-Right" then
                sP = UDim2.new(1,350,0,50+nc*44); eP = UDim2.new(1,-330,0,50+nc*44); xP = UDim2.new(1,350,0,50+nc*44)
            elseif W.CurrentNotifPos == "Top-Left" then
                sP = UDim2.new(0,-350,0,50+nc*44); eP = UDim2.new(0,10,0,50+nc*44); xP = UDim2.new(0,-350,0,50+nc*44)
            elseif W.CurrentNotifPos == "Top-Center" then
