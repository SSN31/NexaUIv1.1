        title.Font = W.CurrentFont; title.TextSize = 12; title.TextXAlignment = Enum.TextXAlignment.Left
        title.ZIndex = 12; title.Parent = header; table.insert(W.FontedElements, title)
        
        local list = Instance.new("ScrollingFrame"); list.Name = "List"
        list.Size = UDim2.new(1,-8,1,-38); list.Position = UDim2.new(0,4,0,34)
        list.BackgroundTransparency = 1; list.BorderSizePixel = 0; list.ScrollBarThickness = 3
        list.ScrollBarImageColor3 = Color3.fromRGB(120,60,150); list.CanvasSize = UDim2.new(0,0,0,0)
        list.AutomaticCanvasSize = Enum.AutomaticSize.Y; list.ZIndex = 10; list.Parent = col
        local ll = Instance.new("UIListLayout", list); ll.Padding = UDim.new(0,4); ll.SortOrder = Enum.SortOrder.LayoutOrder
        local lp = Instance.new("UIPadding", list); lp.PaddingTop = UDim.new(0,2); lp.PaddingBottom = UDim.new(0,4)
        
        ll:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            local currentScale = W.UIScaleVal or 1
            local ch = ll.AbsoluteContentSize.Y / currentScale
            local pad = 38
            local th = math.clamp(ch + pad, 80, COL_H_MAX)
            col.Size = UDim2.new(0, W._currentColW, 0, th)
            list.Size = UDim2.new(1,-8,1,-pad+4)
        end)
        
        local dragging, dragStart, startPos
        header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; dragStart = input.Position; startPos = col.Position
            end
        end)
        header.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false; W.SavedPositions[col.Name] = col.Position
            end
        end)
        local colDragConn = UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - dragStart
                col.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+d.X, startPos.Y.Scale, startPos.Y.Offset+d.Y)
            end
        end)
        table.insert(W._connections, colDragConn)
        
        local fp = UDim2.new(0,posX,0,posY); W.SavedPositions[col.Name] = fp
        col.Position = UDim2.new(fp.X.Scale, fp.X.Offset - (W._currentColW + 40), fp.Y.Scale, fp.Y.Offset)
        col.Visible = false
        
        local cd = {Frame=col, List=list, Header=header, Scale=cs}
        table.insert(W.AllColumns, cd)
        return cd
    end
    
